@model List<RealEase.Domain.Entities.AgentInquiry>

@{
    ViewData["Title"] = "Solicitudes y Prospectos de Clientes";
    var currentStatus = ViewData["CurrentStatus"]?.ToString() ?? "all";
}

<div class="container-xl py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Agent" asp-action="Dashboard" class="text-decoration-none text-secondary">Panel de Agente</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Solicitudes de Clientes</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-2">
                <i class="bi bi-inbox-fill me-1"></i> CRM Inmobiliario
            </span>
            <h1 class="display-6 fw-extrabold text-dark mb-1">Bandeja de Leads y Prospectos</h1>
            <p class="text-secondary mb-0">Gestiona las consultas de clientes interesados en alquilar o vender propiedades en tu zona.</p>
        </div>
        <div>
            <a asp-action="Dashboard" class="btn btn-outline-dark rounded-pill px-4 fw-bold">
                <i class="bi bi-arrow-left me-1"></i> Volver al Panel
            </a>
        </div>
    </div>

    @if (TempData["Success"] is string success) { <div class="alert alert-success rounded-4 shadow-sm mb-4"><i class="bi bi-check-circle-fill me-2"></i>@success</div> }
    @if (TempData["Error"] is string error) { <div class="alert alert-danger rounded-4 shadow-sm mb-4"><i class="bi bi-exclamation-triangle-fill me-2"></i>@error</div> }

    <!-- Filter Pills & Search -->
    <div class="card border-0 rounded-4 shadow-sm bg-white p-3 mb-4">
        <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
            <div class="btn-group p-1 bg-light rounded-pill border" role="group">
                <a asp-action="Inquiries" asp-route-status="all" class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "all" ? "btn-success text-white" : "btn-light text-secondary border-0")">
                    Todas (@Model.Count)
                </a>
                <a asp-action="Inquiries" asp-route-status="pending" class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "pending" ? "btn-success text-white" : "btn-light text-secondary border-0")">
                    Pendientes
                </a>
                <a asp-action="Inquiries" asp-route-status="contacted" class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "contacted" ? "btn-success text-white" : "btn-light text-secondary border-0")">
                    Contactados
                </a>
                <a asp-action="Inquiries" asp-route-status="closed" class="btn btn-sm rounded-pill px-3 fw-bold @(currentStatus == "closed" ? "btn-success text-white" : "btn-light text-secondary border-0")">
                    Cerrados
                </a>
            </div>

            <div class="input-group search-filter-box rounded-pill bg-light px-2 border" style="max-width: 380px;">
                <span class="input-group-text bg-transparent border-0 text-secondary ps-2">
                    <i class="bi bi-search"></i>
                </span>
                <input id="leadSearch" class="form-control border-0 bg-transparent ps-1" placeholder="Buscar por cliente, teléfono o zona..." />
            </div>
        </div>
    </div>

    <!-- Leads List -->
    @if (Model.Count == 0)
    {
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white">
            <i class="bi bi-inbox display-3 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold text-dark">No hay solicitudes en esta categoría</h4>
            <p class="text-secondary max-w-md mx-auto mb-3">Las consultas de los clientes que soliciten información sobre alquileres o deseen vender en tu zona aparecerán aquí.</p>
            <a asp-action="Inquiries" asp-route-status="all" class="btn btn-outline-success rounded-pill px-4 fw-bold">Ver todas las solicitudes</a>
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 g-4" id="leadsContainer">
            @foreach (var inquiry in Model)
            {
                var isRent = string.Equals(inquiry.Intent, "rent", StringComparison.OrdinalIgnoreCase);
                var cleanPhone = new string(inquiry.PhoneNumber.Where(char.IsDigit).ToArray());

                <div class="col lead-item" data-search="@($"{inquiry.Name} {inquiry.PhoneNumber} {inquiry.Email} {inquiry.Location} {inquiry.Message}".ToLowerInvariant())">
                    <div class="card h-100 border-0 shadow-sm rounded-4 p-4 bg-white transition-all hover-shadow">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                            <div>
                                <span class="badge @(isRent ? "bg-success-subtle text-success" : "bg-primary-subtle text-primary") rounded-pill px-2.5 py-1 fw-bold mb-1.5 d-inline-block">
                                    <i class="bi @(isRent ? "bi-key" : "bi-tag") me-1"></i> @(isRent ? "Alquiler" : "Venta")
                                </span>
                                <h5 class="fw-bold text-dark mb-0.5">@inquiry.Name</h5>
                                <p class="text-secondary small mb-0">
                                    <i class="bi bi-geo-alt-fill text-success me-1"></i> @inquiry.Location
                                </p>
                            </div>

                            <form asp-action="UpdateInquiryStatus" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@inquiry.Id" />
                                <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                                <select name="status" class="form-select form-select-sm rounded-pill border fw-semibold" onchange="this.form.submit()">
                                    <option value="pending" selected="@(inquiry.Status == "pending")">🟡 Pendiente</option>
                                    <option value="contacted" selected="@(inquiry.Status == "contacted")">🔵 Contactado</option>
                                    <option value="scheduled" selected="@(inquiry.Status == "scheduled")">🟣 Visita Coordinada</option>
                                    <option value="closed" selected="@(inquiry.Status == "closed")">🟢 Cerrado</option>
                                </select>
                            </form>
                        </div>

                        <!-- Message -->
                        @if (!string.IsNullOrWhiteSpace(inquiry.Message))
                        {
                            <div class="p-3 bg-light rounded-3 border small text-secondary my-3">
                                <strong>Mensaje del cliente:</strong>
                                <p class="mb-0 mt-1">@inquiry.Message</p>
                            </div>
                        }
                        else
                        {
                            <div class="p-2.5 bg-light rounded-3 border small text-muted my-3 fst-italic">
                                Solicitud de contacto sin mensaje adicional.
                            </div>
                        }

                        <div class="mt-auto pt-3 border-top d-flex flex-wrap justify-content-between align-items-center gap-2">
                            <small class="text-muted">
                                <i class="bi bi-clock me-1"></i> @inquiry.CreatedAt.ToLocalTime().ToString("g")
                            </small>

                            <!-- Contact Actions -->
                            <div class="d-flex gap-1.5">
                                @if (!string.IsNullOrWhiteSpace(cleanPhone))
                                {
                                    <a href="https://wa.me/@cleanPhone" target="_blank" class="btn btn-sm btn-success rounded-pill px-3 fw-semibold d-inline-flex align-items-center gap-1" title="Chatear por WhatsApp">
                                        <i class="bi bi-whatsapp"></i> WhatsApp
                                    </a>
                                    <a href="tel:@inquiry.PhoneNumber" class="btn btn-sm btn-light border rounded-pill px-2.5" title="Llamar">
                                        <i class="bi bi-telephone-fill text-dark"></i>
                                    </a>
                                }
                                <a href="mailto:@inquiry.Email" class="btn btn-sm btn-light border rounded-pill px-2.5" title="Enviar correo">
                                    <i class="bi bi-envelope-fill text-dark"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        (() => {
            const search = document.getElementById('leadSearch');
            const items = [...document.querySelectorAll('.lead-item')];

            search?.addEventListener('input', () => {
                const query = search.value.trim().toLowerCase();
                items.forEach(item => {
                    const matches = !query || item.dataset.search.includes(query);
                    item.classList.toggle('d-none', !matches);
                });
            });
        })();
    </script>
}
