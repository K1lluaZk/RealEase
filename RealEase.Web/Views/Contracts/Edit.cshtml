@using RealEase.Domain.Entities
@model Contract

@{
    ViewData["Title"] = "Editar Contrato";
}

<section class="edit-page edit-page--contract">
    <div class="page-heading edit-page-heading">
        <div class="edit-page-title">
            <span class="edit-page-icon"><i class="bi bi-file-earmark-text"></i></span>
            <div><span class="eyebrow">Contratos · #@Model.Id</span><h1>Editar contrato</h1><p>Revisa las partes, el periodo y las condiciones del acuerdo.</p></div>
        </div>
        <a href="/Contracts" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a contratos</a>
    </div>

    <form asp-action="Edit" id="editContractForm" class="form-surface card border-0">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="form-surface-heading"><span class="detail-icon"><i class="bi bi-pencil-square"></i></span><div><h2>Detalles del contrato</h2><p>Completa la información para mantener el acuerdo actualizado.</p></div></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label for="clientIdInput" class="form-label">ID del cliente</label>
                <input type="text" class="form-control" id="clientIdInput" name="ClientId" value="@Model.ClientId" required />
            </div>
            <div class="col-md-6">
                <label for="agentIdInput" class="form-label">ID del agente <span class="text-secondary">(opcional)</span></label>
                <input type="text" class="form-control" id="agentIdInput" name="AgentId" value="@Model.AgentId" />
            </div>
            <div class="col-md-6">
                <label for="propertyIdInput" class="form-label">ID de la propiedad</label>
                <input type="number" min="1" step="1" class="form-control" id="propertyIdInput" name="PropertyId" value="@Model.PropertyId" required />
            </div>
            <div class="col-md-6">
                <label for="statusInput" class="form-label">Estado</label>
                @if (User.IsInRole(RealEase.Domain.Models.UserRoles.Agent))
                {
                    <input class="form-control" id="statusInput" name="Status" value="@Model.Status" readonly />
                    <div class="edit-help">La aprobación se habilitará cuando el pago esté verificado.</div>
                }
                else
                {
                    <input class="form-control" id="statusInput" name="Status" value="@Model.Status" placeholder="Ej. Activo" />
                }
            </div>
            <div class="col-md-6">
                <label for="startDateInput" class="form-label">Fecha de inicio</label>
                <input type="date" class="form-control" id="startDateInput" name="StartDate" value="@Model.StartDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-6">
                <label for="endDateInput" class="form-label">Fecha de finalización</label>
                <input type="date" class="form-control" id="endDateInput" name="EndDate" value="@Model.EndDate.ToString("yyyy-MM-dd")" required />
            </div>
            <div class="col-md-6">
                <label for="monthlyAmountInput" class="form-label">Monto total</label>
                <div class="input-group"><span class="input-group-text">$</span><input type="number" min="0" step="0.01" class="form-control" id="monthlyAmountInput" name="TotalAmount" value="@Model.TotalAmount" required /></div>
            </div>
        </div>

        <div class="form-surface-actions">
            <a href="/Contracts" class="btn btn-light">Cancelar</a>
            <button type="button" id="UpdateContractButton" class="btn btn-realease"><i class="bi bi-check2-circle"></i> Guardar cambios</button>
        </div>
    </form>
</section>


@section Scripts
{
    <script>
        $(document).ready(function () {
            $('#UpdateContractButton').click(function (e) {
                e.preventDefault();
                var contractId = $('input[name="Id"]').val();

                console.log('Contract ID:', contractId);

                var updatedContract = {
                    Id: contractId,
                    ClientId: $('#clientIdInput').val(),
                    AgentId: $('#agentIdInput').val() || null,
                    PropertyId: Number($('#propertyIdInput').val()),
                    StartDate: $('#startDateInput').val(),
                    EndDate: $('#endDateInput').val(),
                    TotalAmount: Number($('#monthlyAmountInput').val()),
                    Status: $('#statusInput').val()
                };

                $.ajax({
                    url: '@Url.Action("UpdateFromApi", "Contracts")',
                    type: 'PUT',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    contentType: 'application/json',
                    data: JSON.stringify(updatedContract),
                    success: function () {
                        alert('Contract updated successfully');
                        window.location.href = '/Contracts';
                    },
                    error: function (error) {
                        console.log('Error:', error);
                        alert('An error occurred while updating the contract.');
                    }
                });
            });
        });
    </script>
}
