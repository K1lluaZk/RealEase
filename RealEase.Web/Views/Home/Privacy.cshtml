@{
    ViewData["Title"] = "Política de Privacidad";
}

<div class="container-xl py-5">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Inicio</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Privacidad</li>
        </ol>
    </nav>

    <!-- Header Banner -->
    <div class="card border-0 rounded-4 p-4 p-md-5 mb-5 bg-white shadow-sm">
        <div class="max-w-2xl">
            <span class="badge bg-success-subtle text-success px-3 py-1.5 rounded-pill fw-bold text-uppercase mb-3">
                <i class="bi bi-shield-check me-1"></i> Protección de Datos
            </span>
            <h1 class="display-5 fw-extrabold text-dark mb-3">Política de Privacidad</h1>
            <p class="lead text-secondary mb-0">
                En <strong class="text-success">RealEase</strong>, tu privacidad es prioritaria. Te explicamos de forma transparente cómo protegemos, tratamos y respetamos tus datos personales al buscar o publicar tu vivienda.
            </p>
        </div>
    </div>

    <div class="row g-4">
        <!-- Main Privacy Content -->
        <div class="col-lg-8">
            <div class="d-grid gap-4">
                <!-- Section 1 -->
                <div class="card border-0 rounded-4 p-4 bg-white shadow-sm">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-person-vcard-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">1. Datos que Recopilamos</h5>
                            <p class="text-secondary small mb-2">
                                Recopilamos únicamente la información necesaria para brindarte un servicio inmobiliario eficiente y personalizado:
                            </p>
                            <ul class="text-secondary small ps-3 mb-0">
                                <li><strong>Información de contacto:</strong> Nombre, correo electrónico y número de teléfono proporcionados voluntariamente en solicitudes de visita o contacto con asesores.</li>
                                <li><strong>Preferencias de búsqueda:</strong> Ubicaciones favoritas, tipo de inmueble buscado y filtros de alquiler o compra.</li>
                                <li><strong>Datos técnicos:</strong> Información básica de navegación y cookies para mantener tu sesión activa y segura.</li>
                            </ul>
                        </div>
                    </div>
                </div>

                <!-- Section 2 -->
                <div class="card border-0 rounded-4 p-4 bg-white shadow-sm">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-bullseye"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">2. Finalidad del Tratamiento de Datos</h5>
                            <p class="text-secondary small mb-0">
                                Tus datos se emplean exclusivamente para:
                                <br />• Conectarte con el agente certificado a cargo de la propiedad de tu interés.
                                <br />• Notificarte y confirmar el horario de tus visitas agendadas.
                                <br />• Mejorar continuamente la relevancia de las publicaciones inmobiliarias que te mostramos.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section 3 -->
                <div class="card border-0 rounded-4 p-4 bg-white shadow-sm">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-lock-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">3. No Venta de Información a Terceros</h5>
                            <p class="text-secondary small mb-0">
                                En RealEase tenemos una política estricta de no comercialización de datos. Jamás vendemos, alquilamos ni transferimos tu información de contacto a anunciantes ni a terceros ajenos a la gestión de tu solicitud inmobiliaria.
                            </p>
                        </div>
                    </div>
                </div>

                <!-- Section 4 -->
                <div class="card border-0 rounded-4 p-4 bg-white shadow-sm">
                    <div class="d-flex align-items-start gap-3">
                        <div class="rounded-circle bg-success-subtle text-success d-flex align-items-center justify-content-center flex-shrink-0" style="width: 44px; height: 44px; font-size: 1.25rem;">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>
                        <div>
                            <h5 class="fw-bold text-dark mb-2">4. Tus Derechos de Acceso y Cancelación</h5>
                            <p class="text-secondary small mb-0">
                                Tienes derecho a solicitar en cualquier momento la revisión, rectificación o eliminación total de tus datos personales de nuestros registros enviando una solicitud a nuestro canal de soporte de privacidad.
                            </p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Info -->
        <div class="col-lg-4">
            <div class="card border-0 rounded-4 p-4 bg-white shadow-sm sticky-top" style="top: 95px;">
                <h5 class="fw-bold text-dark mb-3">Compromiso de Privacidad</h5>
                <p class="text-secondary small mb-3">
                    Cumplimos con las mejores prácticas internacionales y las regulaciones locales sobre protección de datos personales.
                </p>
                <div class="p-3 bg-light rounded-3 border small text-secondary mb-4">
                    <i class="bi bi-shield-fill-check text-success me-1"></i>
                    <strong>Protocolo:</strong> Cifrado de extremo a extremo SSL/TLS
                </div>

                <a href="mailto:privacidad@realease.com" class="btn btn-outline-success rounded-pill btn-sm w-100 fw-bold">
                    <i class="bi bi-envelope me-1"></i> Contactar a oficial de privacidad
                </a>
            </div>
        </div>
    </div>
</div>
