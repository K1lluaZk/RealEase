@model List<RealEase.Application.Dtos.Payment.PaymentDto>

@{
    ViewData["Title"] = "Pagos";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div><h1 class="h2 mb-1">Pagos</h1><p class="text-secondary mb-0">Historial de pagos recibidos y su estado.</p></div>
    <a asp-action="Create" class="btn btn-success">＋ Registrar pago</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (ViewData["ApiError"] is string apiError) { <div class="alert alert-warning">@apiError</div> }

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-0 pt-3 px-3 d-flex justify-content-between align-items-center gap-3">
        <h2 class="h6 mb-0">Listado de pagos</h2>
        <input id="paymentSearch" class="form-control form-control-sm" style="max-width:300px" placeholder="Buscar por contrato, inquilino o estado" />
    </div>
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light"><tr><th>ID</th><th>Contrato</th><th>Inquilino</th><th>Fecha</th><th>Monto</th><th>Método</th><th>Estado</th><th class="text-end">Acciones</th></tr></thead>
            <tbody>
            @foreach (var payment in Model)
            {
                <tr class="payment-row" data-search="@($"{payment.Id} {payment.ContractId} {payment.TenantId} {payment.Status} {payment.PaymentMethod}".ToLowerInvariant())">
                    <td class="text-secondary">#@payment.Id</td>
                    <td>
                        @if (payment.ContractId is long contractId)
                        {
                            <a asp-controller="Contracts" asp-action="Details" asp-route-id="@contractId">#@contractId</a>
                        }
                        else
                        {
                            <span class="text-secondary">Sin contrato</span>
                        }
                    </td>
                    <td class="text-break" style="max-width:180px">@payment.TenantId</td>
                    <td>@payment.PaymentDate.ToLocalTime().ToString("g")</td>
                    <td class="text-nowrap fw-semibold">@payment.Amount.ToString("C")</td>
                    <td>@payment.PaymentMethod</td>
                    <td><span class="badge text-bg-light">@payment.Status</span></td>
                    <td><div class="d-flex justify-content-end gap-2">
                        <a asp-action="Details" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                        <a asp-action="Edit" asp-route-id="@payment.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                        <form asp-action="DeleteFromApi" asp-route-id="@payment.Id" method="post" onsubmit="return confirm('¿Eliminar este pago?');"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form>
                    </div></td>
                </tr>
            }
            @if (Model.Count == 0) { <tr><td colspan="8" class="py-5 text-center text-secondary">No hay pagos registrados.</td></tr> }
            </tbody>
        </table>
    </div>
    <div class="card-footer bg-white text-secondary small">@Model.Count pago(s)</div>
</div>

@section Scripts {
<script>
document.getElementById('paymentSearch')?.addEventListener('input', event => {
    const query = event.target.value.trim().toLocaleLowerCase();
    document.querySelectorAll('.payment-row').forEach(row => row.classList.toggle('d-none', !row.dataset.search.includes(query)));
});
</script>
}
