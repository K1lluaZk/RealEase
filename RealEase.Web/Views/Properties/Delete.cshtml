@using RealEase.Domain.Entities
@model Property

@{
    ViewData["Title"] = "Eliminar Propiedad";
}

<div class="max-w-2xl mx-auto px-4 py-12">
    <div class="bg-red-50 border border-red-100 rounded-2xl p-6 text-center mb-8">
        <div class="w-12 h-12 bg-red-100 text-red-600 rounded-full flex items-center justify-center mx-auto mb-3">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-6 h-6">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v3.75m9-.75a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 3.75h.008v.008H12v-.008Z" />
            </svg>
        </div>
        <h1 class="text-xl font-bold text-red-900">¿Confirmas que deseas eliminar esto?</h1>
        <p class="mt-1 text-sm text-red-700">Esta acción es permanente y no se podrá recuperar la información de este inmueble.</p>
    </div>

    <div class="bg-white border border-gray-100 shadow-sm rounded-2xl overflow-hidden">
        <div class="px-6 py-4 border-b border-gray-100 bg-gray-50/50">
            <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-500">Detalles de la Propiedad</h2>
        </div>

        <div class="divide-y divide-gray-100 px-6">
            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Título</span>
                <span class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0 font-semibold">@Model.Title</span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4 items-center">
                <span class="text-sm font-medium text-gray-500">Imagen</span>
                <div class="mt-1 sm:col-span-2 sm:mt-0 flex items-center space-x-3">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="Preview" class="w-12 h-12 object-cover rounded-lg border border-gray-200" />
                        <span class="text-xs text-gray-400 truncate max-w-xs">@Model.ImageUrl</span>
                    }
                    else
                    {
                        <span class="text-sm text-gray-400 italic">Sin imagen asignada</span>
                    }
                </div>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Descripción</span>
                <span class="mt-1 text-sm text-gray-700 sm:col-span-2 sm:mt-0 line-clamp-2">@(Model.Description ?? "Sin descripción")</span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Dirección</span>
                <span class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">@Model.Address</span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Precio por Noche</span>
                <span class="mt-1 text-sm font-semibold text-emerald-600 sm:col-span-2 sm:mt-0">@Model.PricePerNight.ToString("C") USD</span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Distribución</span>
                <span class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                    👥 Capacidad: @Model.Capacity | 🛏️ Hab: @Model.Bedrooms | 🚿 Baños: @Model.Bathrooms
                </span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Tipo</span>
                <span class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-100">
                        @Model.PropertyType
                    </span>
                </span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">Estado</span>
                <span class="mt-1 text-sm text-gray-900 sm:col-span-2 sm:mt-0">
                    <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-800 border border-gray-200">
                        @Model.Status
                    </span>
                </span>
            </div>

            <div class="py-3 sm:grid sm:grid-cols-3 sm:gap-4">
                <span class="text-sm font-medium text-gray-500">ID Propietario</span>
                <span class="mt-1 text-sm text-gray-600 sm:col-span-2 sm:mt-0 font-mono">#@Model.OwnerId</span>
            </div>
        </div>
    </div>

    <div class="mt-6 flex items-center justify-end space-x-3">
        <form asp-action="Delete" class="w-full sm:w-auto flex items-center justify-end space-x-3">
            <input type="hidden" asp-for="Id" />

            <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-gray-500 transition-all duration-200 text-center">
                Cancelar, volver atrás
            </a>

            <button type="submit" class="px-5 py-2.5 text-sm font-medium text-white bg-red-600 rounded-xl hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 shadow-sm shadow-red-600/10 transition-all duration-200">
                Eliminar Permanentemente
            </button>
        </form>
    </div>
</div>