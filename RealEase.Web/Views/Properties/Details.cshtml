@using RealEase.Domain.Entities
@using RealEase.Domain.Models
@model Property

@{
    ViewData["Title"] = Model.Title;
    var isSale = string.Equals(Model.ListingType, "sale", StringComparison.OrdinalIgnoreCase);
    var price = isSale ? Model.SalePrice : Model.PricePerNight;
    var gallery = PropertyImageHelper.GetGallery(Model.Images, Model.Id);
    var mainImage = gallery.FirstOrDefault() ?? PropertyImageHelper.GetImageUrl(null, Model.Id, Model.PropertyType);
    var secondaryImages = gallery.Skip(1).Take(2).ToList();
}

<div class="container-xl py-4">
    <!-- Breadcrumbs & Navigation -->
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3">
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb small mb-0">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Inicio</a></li>
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="@(isSale ? "Buy" : "Rent")" class="text-decoration-none text-secondary">@(isSale ? "Comprar" : "Alquilar")</a></li>
                <li class="breadcrumb-item active text-dark fw-semibold text-truncate" style="max-width: 250px;" aria-current="page">@Model.Title</li>
            </ol>
        </nav>

        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="navigator.clipboard?.writeText(window.location.href); alert('Enlace copiado al portapapeles');">
                <i class="bi bi-share me-1"></i> Compartir
            </button>
            <a asp-controller="Home" asp-action="@(isSale ? "Buy" : "Rent")" class="btn btn-sm btn-outline-dark rounded-pill px-3">
                <i class="bi bi-arrow-left me-1"></i> Volver a resultados
            </a>
        </div>
    </div>

    <!-- Title and Price Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-start gap-3 mb-4">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                <span class="badge @(isSale ? "bg-primary" : "bg-success") px-3 py-1.5 rounded-pill fw-bold text-uppercase">
                    <i class="bi @(isSale ? "bi-house" : "bi-key") me-1"></i> @(isSale ? "En Venta" : "En Alquiler")
                </span>
                @if (!string.IsNullOrWhiteSpace(Model.PropertyType))
                {
                    <span class="badge bg-light text-dark border px-2.5 py-1.5 rounded-pill fw-medium">
                        @Model.PropertyType
                    </span>
                }
                <span class="badge bg-success-subtle text-success px-2.5 py-1.5 rounded-pill fw-semibold">
                    <i class="bi bi-patch-check-fill me-1"></i> Verificado por RealEase
                </span>
            </div>
            <h1 class="display-6 fw-extrabold text-dark mb-1">@Model.Title</h1>
            <p class="text-secondary mb-0 fs-6">
                <i class="bi bi-geo-alt-fill text-success me-1"></i>
                @(string.IsNullOrWhiteSpace(Model.City) ? "" : $"{Model.City} · ")@Model.Address
            </p>
        </div>

        <div class="text-md-end bg-light p-3 rounded-4 border">
            <div class="small text-secondary fw-semibold">@(isSale ? "Precio de venta" : "Tarifa de alquiler")</div>
            <h2 class="display-6 fw-extrabold @(isSale ? "text-primary" : "text-success") mb-0">
                @(price?.ToString("C0") ?? "Consultar precio")
            </h2>
            @if (!isSale && price.HasValue)
            {
                <span class="text-secondary small fw-medium">por noche · Impuestos incluidos</span>
            }
        </div>
    </div>

    <!-- Photo Gallery Mosaic -->
    <div class="row g-2 rounded-4 overflow-hidden mb-4 property-gallery-mosaic">
        <div class="col-12 @(secondaryImages.Count > 0 ? "col-md-8" : "col-12")">
            <div class="gallery-main-img-wrap position-relative h-100">
                <img src="@mainImage" alt="@Model.Title" class="w-100 h-100 object-fit-cover rounded-3 gallery-feature-img" style="min-height: 380px; max-height: 480px;" />
            </div>
        </div>
        @if (secondaryImages.Count > 0)
        {
            <div class="col-12 col-md-4 d-flex flex-column gap-2">
                @foreach (var subImg in secondaryImages)
                {
                    <div class="gallery-sub-img-wrap flex-fill overflow-hidden rounded-3">
                        <img src="@subImg" alt="@Model.Title interior" class="w-100 h-100 object-fit-cover" style="min-height: 185px; max-height: 235px;" />
                    </div>
                }
            </div>
        }
    </div>

    <!-- Quick Stats Cards Row -->
    <div class="row g-3 mb-5">
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light p-3 rounded-4 h-100 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-bubble bg-white text-success shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="bi bi-door-closed"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Habitaciones</span>
                    <strong class="fs-5 text-dark">@(Model.Bedrooms ?? 1) hab.</strong>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light p-3 rounded-4 h-100 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-bubble bg-white text-success shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="bi bi-droplet"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Baños</span>
                    <strong class="fs-5 text-dark">@(Model.Bathrooms ?? 1) baños</strong>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light p-3 rounded-4 h-100 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-bubble bg-white text-success shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="bi bi-people"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Capacidad</span>
                    <strong class="fs-5 text-dark">@(Model.MaxGuests ?? 2) personas</strong>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="card border-0 bg-light p-3 rounded-4 h-100 d-flex flex-row align-items-center gap-3">
                <div class="stat-icon-bubble bg-white text-success shadow-sm rounded-circle d-flex align-items-center justify-content-center" style="width: 48px; height: 48px; font-size: 1.3rem;">
                    <i class="bi bi-shield-check"></i>
                </div>
                <div>
                    <span class="text-secondary small d-block">Estado</span>
                    <strong class="fs-5 text-dark">@(Model.Status ?? "Disponible")</strong>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content & Sticky Sidebar Grid -->
    <div class="row g-5">
        <!-- Left Column: Details, Description, Amenities -->
        <div class="col-lg-8">
            <!-- Description -->
            <section class="card border-0 bg-white p-4 rounded-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-card-text text-success me-2"></i> Acerca de este hogar
                </h4>
                <p class="text-secondary lead fs-6 lh-base mb-0" style="white-space: pre-line;">
                    @(string.IsNullOrWhiteSpace(Model.Description) 
                        ? "Excelente propiedad ubicada en una de las mejores zonas de la República Dominicana. Disfruta de espacios iluminados, acabados modernos, óptima ventilación y cercanía a centros comerciales, colegios y vías de acceso principales." 
                        : Model.Description)
                </p>
            </section>

            <!-- Amenities & Features -->
            <section class="card border-0 bg-white p-4 rounded-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-stars text-success me-2"></i> Amenidades y Características
                </h4>
                <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 g-3 text-secondary">
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-wifi text-success fs-5"></i>
                        <span>Wifi de alta velocidad</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-snow text-success fs-5"></i>
                        <span>Aire acondicionado</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-water text-success fs-5"></i>
                        <span>Piscina</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-p-circle text-success fs-5"></i>
                        <span>Estacionamiento techado</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-shield-lock text-success fs-5"></i>
                        <span>Seguridad 24/7</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-tree text-success fs-5"></i>
                        <span>Balcón o terraza</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-cup-hot text-success fs-5"></i>
                        <span>Cocina totalmente equipada</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-heart-pulse text-success fs-5"></i>
                        <span>Pet-friendly</span>
                    </div>
                    <div class="col d-flex align-items-center gap-2">
                        <i class="bi bi-sun text-success fs-5"></i>
                        <span>Área infantil / social</span>
                    </div>
                </div>
            </section>

            <!-- Location & Neighborhood -->
            <section class="card border-0 bg-white p-4 rounded-4 shadow-sm mb-4">
                <h4 class="fw-bold text-dark mb-3">
                    <i class="bi bi-geo-alt text-success me-2"></i> Ubicación y Entorno
                </h4>
                <p class="text-secondary mb-3">
                    <strong>Dirección:</strong> @Model.Address, @(string.IsNullOrWhiteSpace(Model.City) ? "República Dominicana" : Model.City).
                </p>
                <div class="p-4 bg-light rounded-4 text-center border">
                    <i class="bi bi-map display-5 text-secondary d-block mb-2"></i>
                    <h6 class="fw-bold text-dark mb-1">Zona residencial y de alta plusvalía</h6>
                    <p class="text-secondary small mb-0">Coordina una visita con el agente local para conocer el vecindario y las inmediaciones.</p>
                </div>
            </section>
        </div>

        <!-- Right Column: Sticky Booking / Inquiry Sidebar -->
        <div class="col-lg-4">
            <aside class="sticky-top" style="top: 95px; z-index: 10;">
                <div class="card border-0 shadow-lg rounded-4 p-4 bg-white">
                    <div class="d-flex justify-content-between align-items-baseline mb-3 pb-3 border-bottom">
                        <div>
                            <span class="text-secondary small">Tarifa</span>
                            <h3 class="fw-extrabold @(isSale ? "text-primary" : "text-success") mb-0">
                                @(price?.ToString("C0") ?? "Consultar")
                            </h3>
                        </div>
                        @if (!isSale && price.HasValue)
                        {
                            <span class="badge bg-success-subtle text-success fw-bold rounded-pill">Alquiler</span>
                        }
                        else
                        {
                            <span class="badge bg-primary-subtle text-primary fw-bold rounded-pill">Venta</span>
                        }
                    </div>

                    @if (TempData["InquirySuccess"] is string success)
                    {
                        <div class="alert alert-success rounded-4 small mb-3" role="alert">
                            <i class="bi bi-check-circle-fill me-1"></i> @success
                            @if (TempData["InquiryAgentName"] is string agentName)
                            {
                                <div class="mt-2 pt-2 border-top">
                                    <strong>Agente:</strong> @agentName <br />
                                    @if (TempData["InquiryAgentEmail"] is string agentEmail) { <a href="mailto:@agentEmail" class="text-decoration-none">@agentEmail</a><br /> }
                                    @if (TempData["InquiryAgentPhone"] is string agentPhone && !string.IsNullOrWhiteSpace(agentPhone)) { <a href="tel:@agentPhone" class="text-decoration-none">@agentPhone</a> }
                                </div>
                            }
                        </div>
                    }

                    @if (TempData["InquiryError"] is string error)
                    {
                        <div class="alert alert-warning rounded-4 small mb-3" role="alert">
                            <i class="bi bi-exclamation-circle me-1"></i> @error
                        </div>
                    }

                    @if (!isSale)
                    {
                        <!-- Rent Inquiry Form -->
                        <div class="mb-3">
                            <h5 class="fw-bold text-dark mb-1">¿Te interesa alquilar?</h5>
                            <p class="text-secondary small mb-3">Envíanos tus datos y el agente a cargo te contactará de inmediato con disponibilidad y requisitos.</p>
                        </div>

                        <form asp-controller="Home" asp-action="ContactAgent" method="post" class="d-grid gap-2.5">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="Intent" value="rent" />
                            <input type="hidden" name="PropertyId" value="@Model.Id" />
                            <input type="hidden" name="ReturnUrl" value="@Url.Action("Details", "Properties", new { id = Model.Id })" />

                            <div>
                                <label class="form-label small fw-bold text-dark" for="inquiryName">Nombre completo</label>
                                <input id="inquiryName" name="Name" class="form-control rounded-pill bg-light border" placeholder="Tu nombre" required maxlength="120" />
                            </div>

                            <div>
                                <label class="form-label small fw-bold text-dark" for="inquiryPhone">Teléfono / WhatsApp</label>
                                <input id="inquiryPhone" name="PhoneNumber" type="tel" class="form-control rounded-pill bg-light border" placeholder="(809) 000-0000" required maxlength="40" />
                            </div>

                            <div>
                                <label class="form-label small fw-bold text-dark" for="inquiryEmail">Correo electrónico</label>
                                <input id="inquiryEmail" name="Email" type="email" class="form-control rounded-pill bg-light border" placeholder="tucorreo@ejemplo.com" required maxlength="254" />
                            </div>

                            <input type="hidden" name="Location" value="@(string.IsNullOrWhiteSpace(Model.City) ? "Santo Domingo" : Model.City)" />

                            <div>
                                <label class="form-label small fw-bold text-dark" for="inquiryMessage">Mensaje <span class="text-secondary fw-normal">(opcional)</span></label>
                                <textarea id="inquiryMessage" name="Message" class="form-control rounded-3 bg-light border" rows="2" placeholder="Me gustaría conocer fechas disponibles o agendar un recorrido..."></textarea>
                            </div>

                            <button type="submit" class="btn btn-success btn-lg rounded-pill fw-bold w-100 mt-2 shadow-sm">
                                <i class="bi bi-chat-dots-fill me-1"></i> Contactar agente
                            </button>
                        </form>
                    }
                    else
                    {
                        <!-- Sale Actions -->
                        <div class="mb-3">
                            <h5 class="fw-bold text-dark mb-1">Programa tu recorrido</h5>
                            <p class="text-secondary small mb-3">Conoce esta propiedad de forma presencial con un agente inmobiliario asignado.</p>
                        </div>

                        <div class="d-grid gap-2">
                            @if (User.IsInRole(UserRoles.Client))
                            {
                                <a asp-controller="Visits" asp-action="Create" asp-route-propertyId="@Model.Id" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-calendar2-check-fill me-1"></i> Agendar visita guiada
                                </a>
                            }
                            else if (User.Identity?.IsAuthenticated != true)
                            {
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Url.Action("Create", "Visits", new { propertyId = Model.Id })" class="btn btn-primary btn-lg rounded-pill fw-bold shadow-sm">
                                    <i class="bi bi-calendar2-check-fill me-1"></i> Inicia sesión para agendar
                                </a>
                            }

                            <a asp-controller="Home" asp-action="Sell" class="btn btn-outline-secondary rounded-pill fw-semibold py-2">
                                Consultar con asesor
                            </a>
                        </div>
                    }

                    <!-- Trust Box in Sidebar -->
                    <div class="mt-4 pt-3 border-top text-secondary small">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-shield-check text-success fs-5"></i>
                            <span class="text-dark fw-semibold">Garantía RealEase</span>
                        </div>
                        <p class="mb-0 text-muted" style="font-size: 0.8rem;">
                            Tus datos se encuentran protegidos. Solo el agente certificado de zona recibirá tu solicitud.
                        </p>
                    </div>

                    @if (User.IsInRole(UserRoles.Admin))
                    {
                        <div class="mt-3 pt-3 border-top">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning btn-sm rounded-pill w-100 fw-bold">
                                <i class="bi bi-pencil-square me-1"></i> Editar como Administrador
                            </a>
                        </div>
                    }
                </div>
            </aside>
        </div>
    </div>
</div>
