@model List<RealEase.Application.Dtos.Property.PropertyDto>

@{
    ViewData["Title"] = "Propiedades";
}

<div class="d-flex flex-wrap align-items-end justify-content-between gap-3 mb-4">
    <div><h1 class="h2 mb-1">Propiedades</h1><p class="text-secondary mb-0">Catálogo conectado a la API de RealEase.</p></div>
    <a asp-action="Create" class="btn btn-success">＋ Nueva propiedad</a>
</div>

@if (TempData["Success"] is string success) { <div class="alert alert-success">@success</div> }
@if (TempData["Error"] is string error) { <div class="alert alert-danger">@error</div> }
@if (ViewData["ApiError"] is string apiError) { <div class="alert alert-warning">@apiError</div> }

<div class="card border-0 shadow-sm mb-4"><div class="card-body">
    <div class="row g-2 align-items-center">
        <div class="col-md"><input id="propertySearch" class="form-control" placeholder="Buscar por nombre o dirección" /></div>
        <div class="col-sm-6 col-md-3"><select id="propertyStatus" class="form-select"><option value="">Todos los estados</option>@foreach (var status in Model.Select(p => p.Status).Where(s => !string.IsNullOrWhiteSpace(s)).Distinct()) { <option value="@status">@status</option> }</select></div>
        <div class="col-auto"><span class="text-secondary small">@Model.Count registro(s)</span></div>
    </div>
</div></div>

@if (Model.Count == 0)
{
    <div class="card border-0 shadow-sm"><div class="card-body py-5 text-center text-secondary">No hay propiedades registradas.</div></div>
}
else
{
    <div class="row g-4" id="propertyList">
        @foreach (var property in Model)
        {
            var image = property.Images?.FirstOrDefault();
            <div class="col-md-6 col-xl-4 property-card" data-search="@($"{property.Title} {property.Address}".ToLowerInvariant())" data-status="@property.Status">
                <article class="card h-100 border-0 shadow-sm overflow-hidden">
                    @if (!string.IsNullOrWhiteSpace(image)) { <img src="@image" class="card-img-top" alt="@property.Title" style="height:210px;object-fit:cover" /> }
                    else { <div class="bg-light d-flex align-items-center justify-content-center text-secondary" style="height:210px">Sin fotografía</div> }
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between gap-2 mb-2"><span class="badge text-bg-light">@property.PropertyType</span><span class="badge text-bg-success">@property.Status</span></div>
                        <h2 class="h5 mb-1">@property.Title</h2>
                        <p class="small text-secondary mb-3">@property.Address</p>
                        <div class="d-flex justify-content-between align-items-center mt-auto pt-3 border-top">
                            <strong>@property.PricePerNight.ToString("C") <span class="small text-secondary fw-normal">/ noche</span></strong>
                            <div class="d-flex gap-2">
                                <a asp-action="Details" asp-route-id="@property.Id" class="btn btn-sm btn-outline-secondary">Ver</a>
                                <a asp-action="Edit" asp-route-id="@property.Id" class="btn btn-sm btn-outline-primary">Editar</a>
                                <form asp-action="DeleteFromApi" asp-route-id="@property.Id" method="post" onsubmit="return confirm('¿Eliminar esta propiedad?');"><button class="btn btn-sm btn-outline-danger">Eliminar</button></form>
                            </div>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
    <div id="noPropertyMatches" class="alert alert-light text-center mt-3 d-none">No hay propiedades que coincidan con la búsqueda.</div>
}

@section Scripts {
<script>
(() => {
    const search = document.getElementById('propertySearch');
    const status = document.getElementById('propertyStatus');
    const cards = [...document.querySelectorAll('.property-card')];
    const empty = document.getElementById('noPropertyMatches');
    function filter() {
        const query = (search?.value || '').trim().toLocaleLowerCase();
        const state = status?.value || '';
        let visible = 0;
        cards.forEach(card => {
            const show = card.dataset.search.includes(query) && (!state || card.dataset.status === state);
            card.classList.toggle('d-none', !show);
            if (show) visible++;
        });
        empty?.classList.toggle('d-none', visible > 0);
    }
    search?.addEventListener('input', filter);
    status?.addEventListener('change', filter);
})();
</script>
}
