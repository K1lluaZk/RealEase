@using RealEase.Domain.Models
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - RealEase | Bienes Raíces</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Outfit:wght@500;600;700;800&display=swap" rel="stylesheet" />
    <link id="bootstrap-css" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/RealEase.Web.styles.css" asp-append-version="true" />
</head>
<body class="re-body">
    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg bg-white border-bottom app-navbar shadow-sm">
            <div class="container-xl">
                <a class="navbar-brand d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index">
                    <span class="brand-logo-icon"><i class="bi bi-house-check-fill"></i></span>
                    <span class="brand-name">Real<span class="brand-accent">Ease</span></span>
                </a>

                <button class="navbar-toggler border-0 shadow-none" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Abrir menú de navegación">
                    <span class="navbar-toggler-icon"></span>
                </button>

                @{
                    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
                    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
                    var isAgent = User.IsInRole(UserRoles.Agent);
                    var isAdmin = User.IsInRole(UserRoles.Admin);
                    var isClient = User.IsInRole(UserRoles.Client);
                }

                <div class="collapse navbar-collapse" id="mainNav">
                    <ul class="navbar-nav mx-auto mb-2 mb-lg-0 align-items-lg-center nav-pills-custom">
                        @if (!isAgent && !isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Buy" ? "active" : "")" asp-controller="Home" asp-action="Buy">
                                    <i class="bi bi-house me-1"></i> Comprar
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Rent" ? "active" : "")" asp-controller="Home" asp-action="Rent">
                                    <i class="bi bi-key me-1"></i> Alquilar
                                    <span class="badge rounded-pill bg-success-subtle text-success ms-1 fw-bold">Popular</span>
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Sell" ? "active" : "")" asp-controller="Home" asp-action="Sell">
                                    <i class="bi bi-tag me-1"></i> Vender
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Home" && currentAction == "Benefits" ? "active" : "")" asp-controller="Home" asp-action="Benefits">
                                    <i class="bi bi-stars me-1"></i> Beneficios
                                </a>
                            </li>
                        }

                        @if (isClient)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Visits" ? "active" : "")" asp-controller="Visits" asp-action="Index">
                                    <i class="bi bi-calendar-event me-1"></i> Mis Visitas
                                </a>
                            </li>
                        }

                        @* Navigation for Real Estate Agent *@
                        @if (isAgent || isAdmin)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentController == "Agent" && currentAction == "Dashboard" ? "active" : "")" asp-controller="Agent" asp-action="Dashboard">
                                    <i class="bi bi-briefcase-fill me-1"></i> Panel de Agente
                                </a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle text-secondary @(currentController == "Agent" || currentController == "Visits" || currentController == "Contracts" || currentController == "Payments" || currentController == "Properties" || currentController == "Users" ? "active" : "")" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-gear-fill me-1"></i> Operaciones
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 p-2">
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Agent" asp-action="Inquiries">
                                            <i class="bi bi-inbox-fill text-success me-2"></i> Solicitudes de Clientes (Leads)
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Agent" asp-action="Visits">
                                            <i class="bi bi-calendar2-check-fill text-success me-2"></i> Agenda de Visitas
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Contracts" asp-action="Index">
                                            <i class="bi bi-file-earmark-text-fill text-primary me-2"></i> Contratos Inmobiliarios
                                        </a>
                                    </li>
                                    <li>
                                        <a class="dropdown-item rounded-3 py-2" asp-controller="Payments" asp-action="Index">
                                            <i class="bi bi-credit-card-fill text-info me-2"></i> Historial de Pagos
                                        </a>
                                    </li>
                                    @if (isAdmin)
                                    {
                                        <li><hr class="dropdown-divider"></li>
                                        <li><span class="dropdown-header small text-uppercase">Administración</span></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Properties" asp-action="Index"><i class="bi bi-building me-2 text-dark"></i> Propiedades</a></li>
                                        <li><a class="dropdown-item rounded-3 py-2" asp-controller="Users" asp-action="Index"><i class="bi bi-people me-2 text-dark"></i> Usuarios</a></li>
                                    }
                                </ul>
                            </li>
                        }
                    </ul>

                    <div class="d-flex align-items-center gap-2 pt-2 pt-lg-0 border-top border-lg-0">
                        @if (!isAgent && !isAdmin)
                        {
                            <a asp-controller="Home" asp-action="Sell" class="btn btn-outline-success btn-sm rounded-pill px-3 fw-semibold d-none d-md-inline-flex align-items-center gap-1">
                                <i class="bi bi-plus-circle"></i> Publicar
                            </a>
                        }

                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <div class="dropdown">
                                <button class="btn btn-light btn-sm rounded-pill px-3 dropdown-toggle d-flex align-items-center gap-2 fw-semibold" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-person-circle text-success fs-6"></i>
                                    <span class="d-inline-block text-truncate" style="max-width: 140px;">@(User.Identity?.Name ?? "Mi Cuenta")</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 rounded-4 p-2">
                                    @if (isAgent)
                                    {
                                        <li class="px-3 py-1 mb-1">
                                            <span class="badge bg-success-subtle text-success rounded-pill fw-bold">Asesor Inmobiliario</span>
                                        </li>
                                        <li><a class="dropdown-item rounded-3" asp-controller="Agent" asp-action="Dashboard"><i class="bi bi-speedometer2 me-2 text-success"></i> Mi Panel</a></li>
                                        <li><a class="dropdown-item rounded-3" asp-controller="Agent" asp-action="Inquiries"><i class="bi bi-inbox me-2 text-success"></i> Mis Solicitudes</a></li>
                                    }
                                    @if (isClient)
                                    {
                                        <li><a class="dropdown-item rounded-3" asp-controller="Visits" asp-action="Index"><i class="bi bi-calendar-event me-2 text-success"></i> Mis Visitas</a></li>
                                    }
                                    <li><hr class="dropdown-divider"></li>
                                    <li>
                                        <form asp-controller="Account" asp-action="Logout" method="post" class="px-1">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-secondary w-100 text-start border-0 rounded-3">
                                                <i class="bi bi-box-arrow-right me-2 text-danger"></i> Cerrar sesión
                                            </button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        }
                        else
                        {
                            <a asp-controller="Account" asp-action="Login" class="btn btn-realease-nav btn-sm rounded-pill px-3 fw-semibold">
                                <i class="bi bi-person"></i> Iniciar sesión
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="app-content" role="main">
        @RenderBody()
    </main>

    <footer class="site-footer bg-white border-top">
        <div class="container-xl py-5">
            <div class="row g-4 justify-content-between">
                <div class="col-lg-4 col-md-6">
                    <a class="navbar-brand d-inline-flex align-items-center gap-2 mb-3" asp-controller="Home" asp-action="Index">
                        <span class="brand-logo-icon"><i class="bi bi-house-check-fill"></i></span>
                        <span class="brand-name">Real<span class="brand-accent">Ease</span></span>
                    </a>
                    <p class="text-secondary small pe-lg-4">
                        Inspirados en la mejor experiencia digital inmobiliaria. Conectamos compradores e inquilinos con hogares verificados y agentes expertos locales para decisiones seguras y transparentes.
                    </p>
                    <div class="d-flex gap-3 text-secondary fs-5 mt-3">
                        <a href="#" class="text-secondary hover-success"><i class="bi bi-instagram"></i></a>
                        <a href="#" class="text-secondary hover-success"><i class="bi bi-facebook"></i></a>
                        <a href="#" class="text-secondary hover-success"><i class="bi bi-linkedin"></i></a>
                        <a href="#" class="text-secondary hover-success"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>

                <div class="col-lg-2 col-6">
                    <h6 class="fw-bold text-dark mb-3">Explorar</h6>
                    <ul class="list-unstyled d-grid gap-2 small">
                        <li><a asp-controller="Home" asp-action="Rent" class="text-decoration-none text-secondary hover-success">Propiedades en Alquiler</a></li>
                        <li><a asp-controller="Home" asp-action="Buy" class="text-decoration-none text-secondary hover-success">Casas en Venta</a></li>
                        <li><a asp-controller="Home" asp-action="Sell" class="text-decoration-none text-secondary hover-success">Vender con un Agente</a></li>
                        <li><a asp-controller="Home" asp-action="Benefits" class="text-decoration-none text-secondary hover-success">¿Por qué RealEase?</a></li>
                    </ul>
                </div>

                <div class="col-lg-2 col-6">
                    <h6 class="fw-bold text-dark mb-3">Zonas Populares</h6>
                    <ul class="list-unstyled d-grid gap-2 small">
                        <li><a asp-controller="Home" asp-action="Rent" asp-route-query="Santo Domingo" class="text-decoration-none text-secondary hover-success">Santo Domingo</a></li>
                        <li><a asp-controller="Home" asp-action="Rent" asp-route-query="Santiago" class="text-decoration-none text-secondary hover-success">Santiago</a></li>
                        <li><a asp-controller="Home" asp-action="Rent" asp-route-query="Punta Cana" class="text-decoration-none text-secondary hover-success">Punta Cana</a></li>
                        <li><a asp-controller="Home" asp-action="Rent" asp-route-query="Las Terrenas" class="text-decoration-none text-secondary hover-success">Las Terrenas</a></li>
                    </ul>
                </div>

                <div class="col-lg-3 col-md-6">
                    <h6 class="fw-bold text-dark mb-3">Atención al Cliente</h6>
                    <p class="text-secondary small mb-2"><i class="bi bi-geo-alt-fill text-success me-2"></i>Av. Winston Churchill, Santo Domingo, D.N.</p>
                    <p class="text-secondary small mb-2"><i class="bi bi-telephone-fill text-success me-2"></i>(809) 555-0199</p>
                    <p class="text-secondary small mb-3"><i class="bi bi-envelope-fill text-success me-2"></i>soporte@realease.com</p>
                    <span class="badge bg-success-subtle text-success py-2 px-3 rounded-pill fw-semibold">
                        <i class="bi bi-patch-check-fill me-1"></i> Inmuebles 100% Verificados
                    </span>
                </div>
            </div>

            <div class="border-top pt-4 mt-4 d-flex flex-column flex-sm-row justify-content-between align-items-center gap-2 small text-secondary">
                <span>© 2026 RealEase Inc. Todos los derechos reservados. Redfin Style Experience.</span>
                <div class="d-flex gap-3">
                    <a asp-controller="Home" asp-action="Terms" class="text-secondary text-decoration-none hover-success">Términos</a>
                    <a asp-controller="Home" asp-action="Privacy" class="text-secondary text-decoration-none hover-success">Privacidad</a>
                    <a asp-controller="Home" asp-action="Security" class="text-secondary text-decoration-none hover-success">Seguridad</a>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
    <script src="/_framework/blazor.server.js"></script>
</body>
</html>
