@using RealEase.Domain.Entities
@model User

@{
    ViewData["Title"] = "Crear Usuario";
}

<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-gray-900 tracking-tight">Crear Nuevo Usuario</h1>
        <p class="mt-2 text-sm text-gray-500">Crea el perfil para un usuario que ya existe en Supabase Auth.</p>
    </div>

    <div class="bg-white border border-gray-100 shadow-sm rounded-2xl p-6 sm:p-8">
        <form asp-action="Create" id="createUserForm" class="space-y-6">
            <div asp-validation-summary="ModelOnly" class="text-sm text-red-600 bg-red-50 p-3 rounded-lg"></div>

            <div>
                <label asp-for="Id" class="block text-sm font-medium text-gray-700 mb-1">UUID del usuario de Supabase Auth</label>
                <input asp-for="Id" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm" id="idInput" placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="FirstName" class="block text-sm font-medium text-gray-700 mb-1">Primer Nombre</label>
                    <input asp-for="FirstName" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-colors duration-200 outline-none" id="firstNameInput" placeholder="Ej. Juan" />
                    <span asp-validation-for="FirstName" class="text-xs text-red-500 mt-1 block"></span>
                </div>

                <div>
                    <label asp-for="LastName" class="block text-sm font-medium text-gray-700 mb-1">Apellido</label>
                    <input asp-for="LastName" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-colors duration-200 outline-none" id="lastNameInput" placeholder="Ej. Pérez" />
                    <span asp-validation-for="LastName" class="text-xs text-red-500 mt-1 block"></span>
                </div>
            </div>

            <div>
                <label asp-for="Email" class="block text-sm font-medium text-gray-700 mb-1">Correo Electrónico</label>
                <input asp-for="Email" type="email" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-colors duration-200 outline-none" id="emailInput" placeholder="ejemplo@dominio.com" />
                <span asp-validation-for="Email" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                    <label asp-for="PhoneNumber" class="block text-sm font-medium text-gray-700 mb-1">Número de Teléfono</label>
                    <input asp-for="PhoneNumber" type="tel" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-colors duration-200 outline-none" id="phoneNumberInput" placeholder="Ej. 809-555-1234" />
                    <span asp-validation-for="PhoneNumber" class="text-xs text-red-500 mt-1 block"></span>
                </div>

            </div>

            <div>
                <label asp-for="Role" class="block text-sm font-medium text-gray-700 mb-1">Rol Asignado</label>
                <input asp-for="Role" class="w-full px-4 py-2 border border-gray-300 rounded-xl shadow-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-500 transition-colors duration-200 outline-none" id="roleInput" list="roles" placeholder="Selecciona o escribe un rol..." />
                <datalist id="roles">
                    <option value="Administrador" />
                    <option value="Agente de ventas" />
                    <option value="Dueño" />
                    <option value="Cliente" />
                </datalist>
                <span asp-validation-for="Role" class="text-xs text-red-500 mt-1 block"></span>
            </div>

            <div class="flex items-center bg-gray-50 p-4 rounded-xl border border-gray-100">
                <div class="flex items-center h-5">
                    <input asp-for="IsActive" type="checkbox" checked class="w-4 h-4 text-emerald-600 border-gray-300 rounded focus:ring-emerald-500 transition-colors cursor-pointer" id="isActiveInput" />
                </div>
                <div class="ml-3 text-sm">
                    <label asp-for="IsActive" class="font-medium text-gray-700 cursor-pointer">Habilitar cuenta inmediatamente</label>
                    <p class="text-xs text-gray-500">El usuario podrá iniciar sesión en la plataforma en cuanto la cuenta sea creada.</p>
                </div>
            </div>

            <div class="flex items-center justify-end space-x-3 pt-4 border-t border-gray-100">
                <a href="/Users" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-all duration-200">
                    Cancelar
                </a>
                <button type="button" id="addUserButton" class="px-5 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 shadow-sm shadow-emerald-600/10 transition-all duration-200">
                    Registrar Usuario
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#addUserButton').click(function (e) {
                e.preventDefault();

                var newUser = {
                    Id: $('#idInput').val(),
                    FirstName: $('#firstNameInput').val(),
                    LastName: $('#lastNameInput').val(),
                    Email: $('#emailInput').val(),
                    PhoneNumber: $('#phoneNumberInput').val(),
                    Role: $('#roleInput').val(),
                    IsActive: $('#isActiveInput').prop('checked')
                };

                $.ajax({
                    url: 'https://localhost:7012/api/Users',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(newUser),
                    success: function (data) {
                        alert('¡Usuario creado con éxito!');
                        // Corregida la redirección relativa para evitar perder el contexto de ruta del servidor
                        window.location.href = '/Users';
                    },
                    error: function (error) {
                        console.log('Error detectado:', error);
                        alert('Ocurrió un error al procesar el alta del usuario.');
                    }
                });
            });
        });
    </script>
}
