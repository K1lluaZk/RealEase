@using RealEase.Domain.Entities
@model User

@{
    ViewData["Title"] = "Detalles del Usuario";
}

<div class="max-w-3xl mx-auto px-4 py-8">

    <div class="mb-6">
        <a asp-action="Index" class="inline-flex items-center text-sm font-medium text-gray-500 hover:text-emerald-600 transition-colors duration-200">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2.5" stroke="currentColor" class="w-4 h-4 mr-1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            Volver al listado
        </a>
    </div>

    <div class="bg-white border border-gray-100 shadow-sm rounded-2xl overflow-hidden mb-6">
        <div class="p-6 sm:p-8 bg-gradient-to-r from-gray-50 to-white border-b border-gray-100 flex flex-col sm:flex-row items-center sm:justify-between gap-4">
            <div class="flex flex-col sm:flex-row items-center text-center sm:text-left space-y-3 sm:space-y-0 sm:space-x-4">
                <div class="w-16 h-16 bg-emerald-100 text-emerald-700 rounded-2xl font-bold text-xl flex items-center justify-center shadow-sm uppercase tracking-wider">
                    @(Model.FirstName?.Substring(0, 1))@(Model.LastName?.Substring(0, 1))
                </div>
                <div>
                    <h1 class="text-2xl font-bold text-gray-900 leading-tight">@Model.FirstName @Model.LastName</h1>
                    <p class="text-sm text-gray-500 font-mono mt-0.5">@Model.Email</p>
                </div>
            </div>

            <div>
                @if (Model.IsActive)
                {
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-100">
                        <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full mr-1.5 animate-pulse"></span> Account Active
                    </span>
                }
                else
                {
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold bg-gray-100 text-gray-500 border border-gray-200">
                        <span class="w-1.5 h-1.5 bg-gray-400 rounded-full mr-1.5"></span> Suspended
                    </span>
                }
            </div>
        </div>

        <div class="px-6 py-2 sm:px-8 divide-y divide-gray-100">
            <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 items-center">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Nombres</span>
                <span class="text-sm text-gray-900 sm:col-span-2 font-medium">@Model.FirstName</span>
            </div>

            <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 items-center">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Apellidos</span>
                <span class="text-sm text-gray-900 sm:col-span-2 font-medium">@Model.LastName</span>
            </div>

            <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 items-center">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Correo Electrónico</span>
                <span class="text-sm text-gray-900 sm:col-span-2 font-mono">@Model.Email</span>
            </div>

            <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 items-center">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Teléfono de Contacto</span>
                <span class="text-sm text-gray-900 sm:col-span-2">
                    @(string.IsNullOrEmpty(Model.PhoneNumber) ? "No asignado" : Model.PhoneNumber)
                </span>
            </div>

            <div class="py-4 grid grid-cols-1 sm:grid-cols-3 gap-2 sm:gap-4 items-center">
                <span class="text-xs font-bold text-gray-400 uppercase tracking-wider">Rol de Plataforma</span>
                <div class="sm:col-span-2">
                    <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-purple-50 text-purple-700 border border-purple-100">
                        🛡️ @Model.Role
                    </span>
                </div>
            </div>
        </div>
    </div>

    <div class="flex items-center justify-end space-x-3">
        <a asp-action="Index" class="px-5 py-2.5 text-sm font-medium text-gray-700 bg-white border border-gray-300 rounded-xl hover:bg-gray-50 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 transition-all duration-200">
            Regresar
        </a>
        <a asp-action="Edit" asp-route-id="@Model?.Id" class="px-5 py-2.5 text-sm font-medium text-white bg-emerald-600 rounded-xl hover:bg-emerald-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-emerald-500 shadow-sm shadow-emerald-600/10 transition-all duration-200 inline-flex items-center">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4 mr-2">
                <path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125" />
            </svg>
            Editar Información
        </a>
    </div>
</div>