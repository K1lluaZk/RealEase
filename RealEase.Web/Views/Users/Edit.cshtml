@using RealEase.Domain.Entities
@model User

@{
    ViewData["Title"] = "Editar Usuario";
}

<section class="edit-page edit-page--user">
    <div class="page-heading edit-page-heading">
        <div class="edit-page-title">
            <span class="edit-page-icon"><i class="bi bi-person-gear"></i></span>
            <div><span class="eyebrow">Usuarios · @Model.FirstName @Model.LastName</span><h1>Editar usuario</h1><p>Modifica los datos de perfil y el acceso de la persona seleccionada.</p></div>
        </div>
        <a href="/Users" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Volver a usuarios</a>
    </div>

    <form asp-action="Edit" id="editUserForm" class="form-surface card border-0">
        @Html.AntiForgeryToken()
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="form-surface-heading"><span class="detail-icon"><i class="bi bi-person-vcard"></i></span><div><h2>Información del perfil</h2><p>Mantén los datos de contacto y el rol actualizados.</p></div></div>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FirstName" class="form-label">Nombres</label>
                <input asp-for="FirstName" class="form-control" id="firstNameInput" required />
                <span asp-validation-for="FirstName" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="LastName" class="form-label">Apellidos</label>
                <input asp-for="LastName" class="form-control" id="lastNameInput" required />
                <span asp-validation-for="LastName" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="Email" class="form-label">Correo electrónico</label>
                <input asp-for="Email" type="email" class="form-control" id="emailInput" required />
                <span asp-validation-for="Email" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="PhoneNumber" class="form-label">Teléfono</label>
                <input asp-for="PhoneNumber" type="tel" class="form-control" id="phoneNumberInput" required />
                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Role" class="form-label">Rol</label>
                <select asp-for="Role" class="form-select" id="roleInput" required>
                    <option value="client">Cliente</option>
                    <option value="agent">Agente</option>
                    <option value="admin">Administrador</option>
                </select>
                <span asp-validation-for="Role" class="text-danger small"></span>
            </div>
            <div class="col-12">
                <label asp-for="ServiceArea" class="form-label">Zonas que atiende</label>
                <input asp-for="ServiceArea" class="form-control" id="serviceAreaInput" placeholder="Ej. Santo Domingo, Santiago" />
                <p class="edit-help">Solo para agentes. Separa las ciudades o zonas con comas para asignar solicitudes de venta.</p>
            </div>
            <div class="col-12">
                <div class="edit-supplement d-flex align-items-center gap-3">
                    <input asp-for="IsActive" type="checkbox" class="form-check-input m-0" id="isActiveInput" />
                    <div>
                        <label for="isActiveInput" class="form-label mb-0">Cuenta activa y habilitada</label>
                        <p class="edit-help mb-0">Determina si el usuario puede operar dentro de la plataforma.</p>
                    </div>
                </div>
            </div>
        </div>

        <div class="form-surface-actions">
            <a href="/Users" class="btn btn-light">Cancelar</a>
            <button type="button" id="UpdateUserButton" class="btn btn-realease"><i class="bi bi-check2-circle"></i> Guardar cambios</button>
        </div>
    </form>
</section>

@section Scripts
{
    <script>
        $(document).ready(function () {
            $('#UpdateUserButton').click(function (e) {
                e.preventDefault();

                // Extracción segura usando el Id generado nativamente por Razor
                var userId = $('#@Html.IdFor(m => m.Id)').val();

                console.log('Procesando cambios para el User ID:', userId);

                var updatedUser = {
                    Id: userId,
                    FirstName: $('#firstNameInput').val(),
                    LastName: $('#lastNameInput').val(),
                    Email: $('#emailInput').val(),
                    PhoneNumber: $('#phoneNumberInput').val(),
                    ServiceArea: $('#serviceAreaInput').val(),
                    Role: $('#roleInput').val(),
                    IsActive: $('#isActiveInput').is(':checked')
                };

                $.ajax({
                    url: '@Url.Action("UpdateFromApi", "Users")',
                    type: 'PUT',
                    headers: { 'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val() },
                    contentType: 'application/json',
                    data: JSON.stringify(updatedUser),
                    success: function () {
                        alert('¡Los datos del usuario se actualizaron correctamente!');
                        window.location.href = '/Users';
                    },
                    error: function (error) {
                        console.log('Error detectado en la actualización:', error);
                        alert('No se pudieron salvar los cambios. Revisa la consola para más detalles.');
                    }
                });
            });
        });
    </script>
}
