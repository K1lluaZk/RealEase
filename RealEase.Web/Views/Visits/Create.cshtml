@using RealEase.Domain.Entities
@model Visit

@{
    ViewData["Title"] = "Agendar Visita";
}

<div class="container-xl py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-secondary">Inicio</a></li>
            <li class="breadcrumb-item"><a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="text-decoration-none text-secondary">Propiedad</a></li>
            <li class="breadcrumb-item active text-success fw-semibold" aria-current="page">Agendar Visita</li>
        </ol>
    </nav>

    <div class="max-w-2xl mx-auto">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden bg-white">
            <div class="p-4 p-md-5">
                <div class="d-flex align-items-center gap-3 mb-4 pb-3 border-bottom">
                    <div class="rounded-circle bg-success text-white d-flex align-items-center justify-content-center flex-shrink-0" style="width: 52px; height: 52px; font-size: 1.4rem;">
                        <i class="bi bi-calendar2-check-fill"></i>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-bold text-uppercase mb-1">
                            Visita Guiada
                        </span>
                        <h3 class="fw-extrabold text-dark mb-0">Solicitar recorrido</h3>
                        <p class="text-secondary small mb-0">@ViewData["PropertyTitle"]</p>
                    </div>
                </div>

                <form id="createVisitForm" class="d-grid gap-3">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="propertyIdInput" value="@Model.PropertyId" />
                    <input type="hidden" id="userIdInput" value="@Model.UserId" />

                    <div>
                        <label for="visitDateInput" class="form-label small fw-bold text-dark">Fecha y hora preferida</label>
                        <input type="datetime-local" class="form-control rounded-pill bg-light border px-3" id="visitDateInput" required />
                        <small class="text-secondary mt-1 d-block">Selecciona un horario de lunes a sábado entre 9:00 AM y 6:00 PM.</small>
                    </div>

                    <div>
                        <label for="notesInput" class="form-label small fw-bold text-dark">Mensaje o indicaciones para el agente <span class="text-secondary fw-normal">(opcional)</span></label>
                        <textarea class="form-control rounded-4 bg-light border p-3" id="notesInput" rows="3" maxlength="500" placeholder="¿Deseas una visita presencial o virtual? ¿Irás acompañado?"></textarea>
                    </div>

                    <div id="visitError" class="alert alert-danger rounded-4 d-none small" role="alert"></div>

                    <div class="d-flex flex-column flex-sm-row justify-content-end gap-2 pt-3 border-top mt-2">
                        <a asp-controller="Properties" asp-action="Details" asp-route-id="@Model.PropertyId" class="btn btn-light rounded-pill px-4 fw-semibold">
                            Cancelar
                        </a>
                        <button type="submit" id="addVisitButton" class="btn btn-success rounded-pill px-4 fw-bold shadow-sm">
                            <i class="bi bi-calendar2-plus me-1"></i> Confirmar solicitud de visita
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById('createVisitForm');
            const dateInput = document.getElementById('visitDateInput');
            const submit = document.getElementById('addVisitButton');
            const error = document.getElementById('visitError');
            const now = new Date();
            now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
            dateInput.min = now.toISOString().slice(0, 16);

            form.addEventListener('submit', async event => {
                event.preventDefault();
                if (!form.reportValidity()) return;

                submit.disabled = true;
                error.classList.add('d-none');
                try {
                    const response = await fetch('@Url.Action("CreateFromApi", "Visits")', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                        },
                        body: JSON.stringify({
                            PropertyId: Number(document.getElementById('propertyIdInput').value),
                            UserId: document.getElementById('userIdInput').value,
                            VisitDate: new Date(dateInput.value).toISOString(),
                            Notes: document.getElementById('notesInput').value
                        })
                    });
                    if (!response.ok) throw new Error('No se pudo agendar la visita. Inténtalo de nuevo.');
                    window.location.href = '@Url.Action("Index", "Visits")';
                } catch (requestError) {
                    error.textContent = requestError.message || 'Error al conectar con el servidor.';
                    error.classList.remove('d-none');
                    submit.disabled = false;
                }
            });
        })();
    </script>
}
